# --------------------------------------------------
# Group: stats
# Queries with stats=all — Ops360 header must survive
# --------------------------------------------------

### @test Ops360 Range with Stats - system.cpu.time
# @name Query system.cpu.time with stats (range)
# @description stats=all requests execution statistics — confirms stats do not interfere with Ops360 header injection
# @group stats
POST {{query_endpoint}}/api/v1/query_range
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=rate(system_cpu_time[5m])&start={{start}}&end={{end}}&step={{step}}&stats=all

# @assert status == 200
# @assert $.status == success
# @assert $.data.resultType == matrix
# @assert $.headers.x-ms-is-ops360-query == true

### @test Ops360 Instant with Stats - system.memory.usage
# @name Query system.memory.usage with stats (instant)
# @description Validates Ops360 header in instant query path when stats are computed alongside
# @group stats
POST {{query_endpoint}}/api/v1/query
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=system_memory_usage&stats=all

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == true

# --------------------------------------------------
# Group: error-cases
# Error handling validation
# --------------------------------------------------

### @test Invalid PromQL Returns 400
# @name Malformed PromQL returns 400
# @description Syntactically invalid PromQL (unclosed bracket) — parser rejects before metric resolution
# @group error-cases
POST {{query_endpoint}}/api/v1/query
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=rate(system_cpu_time[)

# @assert status == 400
# @assert $.status == error
# @assert $.errorType != null

### @test Unauthorized Without Token
# @name Missing auth returns 401
# @description Query with no Authorization header — confirms auth is enforced at the gateway level
# @group error-cases
GET {{query_endpoint}}/api/v1/query?query=system_cpu_time

# @assert status == 401
