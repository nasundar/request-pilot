# ============================================================
# Ops360 Container-Centric — E2E Tests
#
# Validates that Ops360 metric queries flowing through
# PromWebApi correctly set the X-Ms-Is-Ops360-Query response
# header against a resource-centric (container-centric) AMW.
#
# Ops360 metrics: system.cpu.time, system.disk.io,
# system.disk.operations, system.disk.operation_time,
# system.filesystem.usage, system.memory.usage,
# system.network.io, system.network.errors,
# system.network.dropped, system.uptime.
#
# IsOps360Query uses AND logic across all Select() calls:
#   all Ops360 → true | any non-Ops360 → false
#
# Execution model:
#   @setup  — sequential (auth → resolve endpoint → auth)
#   @test   — grouped parallel (see @group directives)
#   @teardown — none (read-only queries)
#
# Prerequisites:
#   - Azure AD service principal with:
#       • "Monitoring Reader" on the target AMW
#       • "Reader" on the AMW resource (for ARM GET)
#   - AMW must have container/Ops360 metrics ingested
# ============================================================

@variables
# --- Authentication ---
tenant_id = your-tenant-id
client_id = your-client-id
client_secret = your-client-secret
arm_scope = https://management.azure.com/.default
prometheus_scope = https://prometheus.monitor.azure.com/.default

# --- Azure Monitor Workspace ---
amw_resource_id = /subscriptions/1f3fa6d2-851c-4a91-9087-1a050f3a9c38/resourceGroups/ai_naga-otel-demo-cumulative-explicit_c8db58a7-1361-4cc2-a0ff-d952b743715e_managed/providers/Microsoft.Monitor/accounts/managed-Naga-OTEL-Demo-Cumulative-Explic-amw
arm_api_version = 2023-04-03

# --- Extracted at runtime (populated by @setup blocks) ---
arm_token =
query_endpoint =
access_token =

# --- Time Range (adjust to a recent window with data) ---
start = 2026-03-17T19:00:00Z
end = 2026-03-17T19:05:00Z
step = 60

# ============================================================
#  SETUP — Sequential: Auth → Resolve Endpoint → Auth
# ============================================================

### @setup Authenticate against ARM
# @name Fetch ARM Access Token
# @description Obtains OAuth2 token for Azure Resource Manager to retrieve AMW properties
POST https://login.microsoftonline.com/{{tenant_id}}/oauth2/v2.0/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id={{client_id}}&client_secret={{client_secret}}&scope={{arm_scope}}

# @extract arm_token = $.access_token
# @assert status == 200
# @assert $.access_token != null
# @assert $.token_type == Bearer

### @setup Resolve Prometheus Query Endpoint from AMW
# @name Get AMW Resource Properties
# @description Calls ARM GET for Microsoft.Monitor/accounts to extract the Prometheus query endpoint URL dynamically
GET https://management.azure.com{{amw_resource_id}}?api-version={{arm_api_version}}
Authorization: Bearer {{arm_token}}

# @extract query_endpoint = $.properties.metrics.prometheusQueryEndpoint
# @assert status == 200
# @assert $.properties.metrics.prometheusQueryEndpoint != null
# @assert $.properties.provisioningState == Succeeded

### @setup Authenticate against Prometheus
# @name Fetch Prometheus Access Token
# @description Obtains OAuth2 token scoped to Prometheus query endpoint for all subsequent tests
POST https://login.microsoftonline.com/{{tenant_id}}/oauth2/v2.0/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id={{client_id}}&client_secret={{client_secret}}&scope={{prometheus_scope}}

# @extract access_token = $.access_token
# @assert status == 200
# @assert $.access_token != null
# @assert $.token_type == Bearer

# ============================================================
#  TESTS — All groups run in parallel after setup completes
# ============================================================

# --------------------------------------------------
# Group: ops360-instant
# Instant queries for each Ops360 metric — all parallel
# --------------------------------------------------

### @test Ops360 Instant - system.cpu.time
# @name Query system.cpu.time (instant)
# @description Raw instant query for system.cpu.time — recognized Ops360 metric matched in Ops360MetricsMap during QW Select()
# @group ops360-instant
GET {{query_endpoint}}/api/v1/query?query=system_cpu_time
Authorization: Bearer {{access_token}}

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == true

### @test Ops360 Instant - system.cpu.time with rate
# @name Query rate(system.cpu.time) (instant)
# @description Wraps system.cpu.time in rate() to verify PromQL functions do not interfere with Ops360 detection
# @group ops360-instant
POST {{query_endpoint}}/api/v1/query
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=rate(system_cpu_time[5m])

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == true

