# --------------------------------------------------
# Group: non-ops360
# Non-Ops360 metrics must return header: false
# --------------------------------------------------

### @test Non-Ops360 Instant - up metric
# @name Query 'up' metric (instant)
# @description 'up' is NOT in Ops360MetricsMap — mdmClient ANDs initial true with IsOps360Metric("up")=false
# @group non-ops360
GET {{query_endpoint}}/api/v1/query?query=up
Authorization: Bearer {{access_token}}

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == false

### @test Non-Ops360 Range - up metric
# @name Query 'up' metric (range)
# @description Confirms negative Ops360 case through query_range pipeline including QF codec aggregation
# @group non-ops360
POST {{query_endpoint}}/api/v1/query_range
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=up&start={{start}}&end={{end}}&step={{step}}

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == false

# --------------------------------------------------
# Group: mixed-query
# Mixed Ops360 + non-Ops360 → AND logic → false
# --------------------------------------------------

### @test Mixed Query - Ops360 and non-Ops360 in expression
# @name Mixed system_cpu_time + up (range)
# @description Two Select() calls: system_cpu_time→AND true, up→AND false = false. QF aggregates via atomic.Bool AND.
# @group mixed-query
POST {{query_endpoint}}/api/v1/query_range
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=system_cpu_time * on() group_left up&start={{start}}&end={{end}}&step={{step}}

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == false

# --------------------------------------------------
# Group: aggregations
# PromQL aggregations over Ops360 metrics — header: true
# --------------------------------------------------

### @test Ops360 Aggregation - sum by cpu
# @name Aggregated sum by cpu (range)
# @description sum() grouped by 'cpu' over rate(system_cpu_time) — single Ops360 metric so header is true
# @group aggregations
POST {{query_endpoint}}/api/v1/query_range
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=sum by (cpu) (rate(system_cpu_time[5m]))&start={{start}}&end={{end}}&step={{step}}

# @assert status == 200
# @assert $.status == success
# @assert $.data.resultType == matrix
# @assert $.headers.x-ms-is-ops360-query == true

### @test Ops360 Aggregation - avg memory
# @name Aggregated avg memory (range)
# @description avg(system_memory_usage) — label-dropping aggregation preserves Ops360 classification
# @group aggregations
POST {{query_endpoint}}/api/v1/query_range
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=avg(system_memory_usage)&start={{start}}&end={{end}}&step={{step}}

# @assert status == 200
# @assert $.status == success
# @assert $.data.resultType == matrix
# @assert $.headers.x-ms-is-ops360-query == true

### @test Ops360 Aggregation - topk network io
# @name TopK network io (instant)
# @description topk(5) over rate(system_network_io) — validates topk retains the Ops360 header
# @group aggregations
POST {{query_endpoint}}/api/v1/query
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=topk(5, rate(system_network_io[5m]))

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == true

