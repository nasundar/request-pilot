# --------------------------------------------------
# Group: ops360-range
# Range queries for each Ops360 metric — all parallel
# --------------------------------------------------

### @test Ops360 Range - system.cpu.time
# @name Query system.cpu.time (range)
# @description Range query through QF → QW pipeline ensuring the Ops360 header survives the codec round-trip
# @group ops360-range
POST {{query_endpoint}}/api/v1/query_range
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=system_cpu_time&start={{start}}&end={{end}}&step={{step}}

# @assert status == 200
# @assert $.status == success
# @assert $.headers.x-ms-is-ops360-query == true

### @test Ops360 Range - rate of system.cpu.time
# @name Query rate(system.cpu.time) (range)
# @description Range query with rate() — confirms matrix result and Ops360 header via QF DecodeResponse → EncodeResponse
# @group ops360-range
POST {{query_endpoint}}/api/v1/query_range
Authorization: Bearer {{access_token}}
Content-Type: application/x-www-form-urlencoded

query=rate(system_cpu_time[5m])&start={{start}}&end={{end}}&step={{step}}

# @assert status == 200
# @assert $.status == success
# @assert $.data.resultType == matrix
# @assert $.headers.x-ms-is-ops360-query == true

### @test Ops360 Range - system.memory.usage
# @name Query system.memory.usage (range)
