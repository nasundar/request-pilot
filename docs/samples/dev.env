# @@name dev
# Request Pilot — Dev environment
# Load via desktop toolbar 🌐 or TUI Ctrl+E.
# Values here override same-named @name = value defaults in your .http file.

BASE_URL=https://dev.api.example.com
AUTH_SCOPE=https://dev.api.example.com/.default
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=dev-client-id
# Treat any secrets as gitignored in real usage.
CLIENT_SECRET=dev-secret-replace-me
