{
  "productName": "Request Pilot",
  "version": "0.1.0",
  "identifier": "com.requestpilot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Request Pilot",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:;"
    },
    "withGlobalTauri": true
  }
}
